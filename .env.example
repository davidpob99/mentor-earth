# Copy to .env (which is git-ignored) and fill in.

# Email: without EMAIL_HOST, sign-in codes are printed to the server console.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=youraccount@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=youraccount@gmail.com

# Production
# SECRET_KEY=
# DEBUG=false
# ALLOWED_HOSTS=mentoring.example.org
# CSRF_TRUSTED_ORIGINS=https://mentoring.example.org
